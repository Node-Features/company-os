# Postgres connection string — Supabase dashboard → Settings → Database →
# Connection string. Use "Direct connection" if your network has outbound
# IPv6 (Supabase's direct host is IPv6-only without the paid IPv4 add-on),
# otherwise use "Session pooler" (IPv4, port 5432, username
# postgres.<project-ref>). Either supports LISTEN/NOTIFY, which ADR-0004's
# notification-recovery item needs — the "Transaction pooler" (port 6543)
# does NOT and must not be used here.
DATABASE_URL=

# Optional. Transaction-mode pooler (port 6543) — not used by companyd's
# long-lived pool (breaks LISTEN/NOTIFY). Only fill this in if something
# short-lived/high-concurrency (e.g. a serverless function) needs it.
DATABASE_URL_TRANSACTION_POOLER=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=8080

# Intelligence providers for the first-slice IntelligenceCapability's
# dispatch. cmd/companyd/main.go's buildProviders wires in whichever of
# these are set, in this priority order (Gemini, OpenAI, Anthropic), behind
# internal/adapters/intelligence/fallback: it dispatches to the first
# provider not currently in a post-rate-limit/outage cooldown, so if Gemini
# rate-limits or goes down, companyd automatically retries the same request
# on OpenAI/Anthropic instead of failing it. Set at least one; none set
# means companyd starts and CREATE_WORKFLOW/START_WORKFLOW still work, but
# Runtime dispatch fails every attempt.
#
# GEMINI_API_KEY (gemini-2.5-flash): https://ai.google.dev/gemini-api/docs/api-key
# See docs/adr/ADR-0004-first-slice-technology-stack.md and internal/adapters/intelligence/gemini.
GEMINI_API_KEY=

# OPENAI_API_KEY (gpt-5-nano). See internal/adapters/intelligence/openai.
OPENAI_API_KEY=

# ANTHROPIC_API_KEY (claude-haiku-4-5). See internal/adapters/intelligence/anthropic.
ANTHROPIC_API_KEY=
