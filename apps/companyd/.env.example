# Postgres connection string — Supabase dashboard → Settings → Database →
# Connection string. Use "Direct connection" if your network has outbound
# IPv6 (Supabase's direct host is IPv6-only without the paid IPv4 add-on),
# otherwise use "Session pooler" (IPv4, port 5432, username
# postgres.<project-ref>). Either supports LISTEN/NOTIFY, which ADR-0004's
# notification-recovery item needs — the "Transaction pooler" (port 6543)
# does NOT and must not be used here.
DATABASE_URL=

# Optional. Transaction-mode pooler (port 6543) — not used by companyd's
# long-lived pool (breaks LISTEN/NOTIFY). Only fill this in if something
# short-lived/high-concurrency (e.g. a serverless function) needs it.
DATABASE_URL_TRANSACTION_POOLER=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=8080
